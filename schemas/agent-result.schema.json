{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/code-reverse-agent/agent-result.schema.json",
  "title": "AgentResult",
  "type": "object",
  "required": ["schema_version", "task_id", "status", "findings", "artifacts", "warnings"],
  "properties": {
    "schema_version": {"type": "string"},
    "task_id": {"type": "string"},
    "status": {"type": "string", "enum": ["success", "partial", "failed"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["file", "line"],
      "properties": {
        "file": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "snippet_hash": {"type": "string"},
        "ast_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["kind", "confidence", "evidence"],
      "properties": {
        "kind": {"type": "string"},
        "source": {"type": "string"},
        "target": {"type": "string"},
        "event": {"type": "string"},
        "condition": {"type": "string"},
        "execution_context": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
