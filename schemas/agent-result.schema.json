{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/code-reverse-agent/schemas/agent-result.schema.json",
  "title": "StageResult（阶段产物信封）",
  "description": "对内流水线每个阶段的产物信封：所有阶段 JSON 都必须携带这些字段。",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "status",
    "generated_at",
    "inputs",
    "findings",
    "evidence",
    "warnings"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "run_id": {"$ref": "common.schema.json#/$defs/run_id"},
    "task_id": {"$ref": "common.schema.json#/$defs/task_id"},
    "stage": {"type": "string", "description": "阶段名，例如 01-index"},
    "status": {"$ref": "common.schema.json#/$defs/status"},
    "generated_at": {"type": "string", "format": "date-time"},
    "inputs": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/artifact_ref"},
      "description": "本阶段读入的产物"
    },
    "findings": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/finding"}},
    "evidence": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidence"}},
    "artifacts": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifact_ref"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "stats": {"type": "object"}
  },
  "additionalProperties": false
}
