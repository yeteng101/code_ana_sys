{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/code-reverse-agent/schemas/resource-flow-validation.schema.json",
  "title": "ResourceFlowValidationDataset",
  "type": "object",
  "required": ["schema_version", "dataset_id", "resources"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "dataset_id": {"type": "string"},
    "description": {"type": "string"},
    "created_at": {"type": "string"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "family",
          "resource_type",
          "operations",
          "ownership_model",
          "paths",
          "ground_truth",
          "evidence"
        ],
        "properties": {
          "id": {"type": "string"},
          "repository": {"type": "string"},
          "commit": {"type": "string"},
          "build_profile": {"type": "string"},
          "family": {"type": "string"},
          "resource_type": {"type": "string"},
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["operation_id", "kind", "api", "function", "location", "evidence_ids"],
              "properties": {
                "operation_id": {"type": "string"},
                "kind": {
                  "type": "string",
                  "enum": ["acquire", "use", "retain", "release", "drop_ref", "transfer", "borrow", "escape", "invalidate"]
                },
                "api": {"type": "string"},
                "function": {"type": "string"},
                "location": {
                  "type": "object",
                  "required": ["file", "line", "snippet"],
                  "properties": {
                    "file": {"type": "string"},
                    "line": {"type": "integer", "minimum": 1},
                    "snippet": {"type": "string"}
                  },
                  "additionalProperties": true
                },
                "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              },
              "additionalProperties": true
            }
          },
          "ownership_model": {"type": "string"},
          "lifetime": {"type": "object"},
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path_id", "condition", "operations", "complete", "evidence_ids"],
              "properties": {
                "path_id": {"type": "string"},
                "condition": {"type": "string"},
                "operations": {"type": "array", "items": {"type": "string"}},
                "complete": {"type": "boolean"},
                "termination_reason": {"type": "string"},
                "evidence_ids": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": true
            }
          },
          "ground_truth": {
            "type": "object",
            "required": ["classification", "reason", "review"],
            "properties": {
              "classification": {
                "type": "string",
                "enum": ["no_leak", "leak", "double_free", "use_after_free", "uncertain"]
              },
              "reason": {"type": "string"},
              "review": {"type": "string"}
            },
            "additionalProperties": false
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "kind", "location"],
              "properties": {
                "id": {"type": "string"},
                "kind": {"type": "string"},
                "location": {
                  "type": "object",
                  "required": ["file", "line", "snippet"],
                  "properties": {
                    "file": {"type": "string"},
                    "line": {"type": "integer", "minimum": 1},
                    "snippet": {"type": "string"}
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
