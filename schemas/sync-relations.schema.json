{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/code-reverse-agent/schemas/sync-relations.schema.json",
  "title": "SyncRelations（外部同步关系结果）",
  "type": "object",
  "required": ["schema_version", "run_id", "result_type", "status", "items", "evidence", "warnings"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "run_id": {"type": "string"},
    "result_type": {"const": "sync_relation"},
    "status": {"type": "string", "enum": ["succeeded", "partial", "failed", "not_available"]},
    "generated_at": {"type": "string"},
    "source": {"type": "object"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "relation_type",
          "source",
          "target",
          "order",
          "execution_context",
          "confidence",
          "evidence_ids"
        ],
        "properties": {
          "id": {"type": "string"},
          "relation_type": {
            "type": "string",
            "enum": [
              "mutex_lock",
              "rwlock",
              "atomic",
              "barrier",
              "condition_variable",
              "event_wait",
              "event_notify",
              "thread_join",
              "happens_before"
            ]
          },
          "source": {"type": "object"},
          "target": {"type": "object"},
          "order": {"type": "string", "enum": ["happens_before", "happens_after", "concurrent", "unknown"]},
          "execution_context": {"type": "object"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "evidence": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
