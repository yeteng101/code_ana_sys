{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/code-reverse-agent/schemas/verification.schema.json",
  "title": "Verification（验证产物）",
  "description": "06-verify 阶段产物：每条链的核查结果、覆盖率与冲突。",
  "type": "object",
  "required": ["schema_version", "run_id", "stage", "status", "generated_at", "checks", "coverage", "conflicts"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "run_id": {"$ref": "common.schema.json#/$defs/run_id"},
    "stage": {"const": "06-verify"},
    "status": {"$ref": "common.schema.json#/$defs/status"},
    "generated_at": {"type": "string", "format": "date-time"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "result", "method", "evidence_ids", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "claim": {"type": "string"},
          "result": {"type": "string", "enum": ["confirmed", "refuted", "uncertain"]},
          "method": {
            "type": "string",
            "enum": ["source_recheck", "clang_reparse", "heuristic", "gold_compare"]
          },
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": ["requested_edges", "confirmed_edges", "coverage_rate"],
      "properties": {
        "requested_edges": {"type": "integer", "minimum": 0},
        "confirmed_edges": {"type": "integer", "minimum": 0},
        "coverage_rate": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_a", "claim_b", "reason"],
        "properties": {
          "claim_a": {"type": "string"},
          "claim_b": {"type": "string"},
          "reason": {"type": "string"},
          "resolution": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "report_ready": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
