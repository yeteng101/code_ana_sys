{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/code-reverse-agent/schemas/call-chain-validation.schema.json",
  "title": "CallChainValidationDataset",
  "type": "object",
  "required": ["schema_version", "dataset_id", "samples"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "dataset_id": {"type": "string"},
    "description": {"type": "string"},
    "created_at": {"type": "string"},
    "label_policy": {"type": "object"},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "graph",
          "claim",
          "label",
          "expected_exists",
          "resolution",
          "candidate_targets",
          "evidence",
          "tags",
          "notes"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "graph": {"type": "string"},
          "claim": {
            "type": "object",
            "required": ["source", "target", "kind"],
            "properties": {
              "source": {"type": "string"},
              "target": {"type": "string"},
              "kind": {"type": "string", "enum": ["direct_call", "callback_edge", "indirect_call"]}
            },
            "additionalProperties": false
          },
          "label": {"type": "string", "enum": ["positive", "negative", "uncertain"]},
          "expected_exists": {"type": "boolean"},
          "resolution": {"type": "string", "enum": ["unique", "multiple_candidates", "unresolved"]},
          "candidate_targets": {"type": "array", "items": {"type": "string"}},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "line", "snippet"],
              "properties": {
                "file": {"type": "string"},
                "line": {"type": "integer", "minimum": 1},
                "snippet": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "tags": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
