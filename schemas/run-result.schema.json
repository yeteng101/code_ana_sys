{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/code-reverse-agent/schemas/run-result.schema.json",
  "title": "RunResult",
  "description": "GET /api/v1/runs/{run_id} 的任务状态与结果摘要，也用于 webhook 完成通知。",
  "type": "object",
  "required": ["schema_version", "run_id", "task_id", "status", "summary", "stats", "warnings"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "run_id": {"$ref": "common.schema.json#/$defs/run_id"},
    "task_id": {"$ref": "common.schema.json#/$defs/task_id"},
    "status": {"$ref": "common.schema.json#/$defs/status"},
    "query": {"type": "object", "description": "回显请求中的 query 部分"},
    "summary": {"type": "string", "description": "自然语言总结（完成后才有）"},
    "findings": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/finding"}},
    "evidence": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidence"}},
    "stats": {
      "type": "object",
      "required": ["started_at"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "symbols": {"type": "integer", "minimum": 0},
        "nodes": {"type": "integer", "minimum": 0},
        "edges": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "artifacts": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifact_ref"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
