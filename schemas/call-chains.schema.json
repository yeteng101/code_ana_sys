{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/code-reverse-agent/schemas/call-chains.schema.json",
  "title": "CallChains（外部调用链结果）",
  "type": "object",
  "required": ["schema_version", "run_id", "result_type", "status", "items", "evidence", "warnings"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "run_id": {"type": "string"},
    "result_type": {"const": "call_chain"},
    "status": {"type": "string", "enum": ["succeeded", "partial", "failed"]},
    "generated_at": {"type": "string"},
    "source": {"type": "object"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "entry", "direction", "nodes", "edges", "confidence", "evidence_ids"],
        "properties": {
          "id": {"type": "string"},
          "entry": {"type": "string"},
          "direction": {"type": "string", "enum": ["caller_to_callee", "callee_to_caller"]},
          "nodes": {"type": "array", "items": {"type": "object"}},
          "edges": {"type": "array", "items": {"type": "object"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "evidence": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
