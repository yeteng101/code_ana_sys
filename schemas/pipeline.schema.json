{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/code-reverse-agent/schemas/pipeline.schema.json",
  "title": "PipelineConfig",
  "description": "内部流水线配置：登记阶段命令、输入与输出；协作组可替换或插入阶段。",
  "type": "object",
  "required": ["pipeline_version", "run_id", "stages"],
  "properties": {
    "pipeline_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "run_id": {"$ref": "common.schema.json#/$defs/run_id"},
    "workspace_root": {"type": "string", "description": "工作目录，相对项目根"},
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "order", "command", "inputs", "outputs"],
        "properties": {
          "name": {"type": "string"},
          "order": {"type": "integer"},
          "command": {
            "type": "array",
            "items": {"type": "string"},
            "description": "可执行命令，例如 [\"clang-symbol-indexer\", \"--workspace\", \"{workspace}\"]"
          },
          "inputs": {
            "type": "array",
            "items": {"type": "string"},
            "description": "需要读取的产物路径（相对 workspace_root）"
          },
          "outputs": {"type": "array", "items": {"type": "string"}},
          "optional": {"type": "boolean", "default": false, "description": "失败时是否允许下游继续"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
